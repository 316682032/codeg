{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codeg",
  "version": "0.38.0-1",
  "identifier": "app.codeg",
  "build": {
    "beforeDevCommand": "pnpm tauri:before-dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm tauri:before-build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../out": "web/"
    },
    "externalBin": [
      "binaries/codeg-mcp",
      "binaries/codeg-computer-helper",
      "binaries/codeg-cli"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "./linux/main.desktop"
      },
      "rpm": {
        "desktopTemplate": "./linux/main.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["codeg"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzNUY1RUUwODU4MTQ2OApSV1JvRkZnSTd2VTFCV053L1FMWlp4dmRsNmtzSCttUys5K0h2YlQwOGFNc1dHeG5TcmNxSHd1Rwo=",
      "endpoints": [
        "https://github.com/keh4l/codeg/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
